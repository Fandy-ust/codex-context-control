{
  "name": "codex-context-control",
  "version": "0.17.2",
  "private": true,
  "type": "module",
  "description": "Local per-chat context budgets for Codex Desktop",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "build:mac": "node scripts/build-mac.mjs",
    "build:win": "node scripts/build-win.mjs",
    "package:win": "node scripts/package-win.mjs",
    "dev:win": "node scripts/dev-win.mjs",
    "test:win:ui-smoke": "node scripts/dev-win.mjs --demo --smoke-test",
    "test:win:package": "node scripts/test-win-package.mjs",
    "test:win:update": "node scripts/test-win-update.mjs",
    "install:win": "node scripts/install-win.mjs",
    "uninstall:win": "node scripts/install-win.mjs --uninstall",
    "install:local": "node scripts/install-current.mjs",
    "uninstall:local": "node scripts/install-current.mjs --uninstall",
    "doctor": "node src/cli.mjs doctor",
    "start": "node src/cli.mjs start",
    "test:stress": "node scripts/stress-app.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "test:distribution": "node --test test/distribution.test.mjs"
  },
  "dependencies": {
    "js-tiktoken": "1.0.21"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "44.9.0",
    "rcedit": "5.0.2"
  }
}
